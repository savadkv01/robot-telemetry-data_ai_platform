          {
            "matcher": { "id": "byName", "options": "Avg Speed (m/s)" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 1.5 },
                    { "color": "red", "value": 2.5 }
