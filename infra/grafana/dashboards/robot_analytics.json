        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Anomaly Count" }]
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT robot_id AS \"Robot ID\", MAX(event_ts) AS \"Last Seen\", ROUND(AVG(speed_mps)::numeric, 3) AS \"Avg Speed (m/s)\", ROUND(MIN(battery_degradation_score)::numeric, 1) AS \"Best Battery Score\", ROUND(MAX(battery_degradation_score)::numeric, 1) AS \"Worst Battery Score\", SUM(anomaly_flag) AS \"Anomaly Count\", COUNT(*) AS \"Total Events\" FROM telemetry_operational WHERE $__timeFilter(event_ts) GROUP BY robot_id ORDER BY \"Anomaly Count\" DESC",
          "refId": "A"
        }
      ],
      "title": "Fleet Health Snapshot",
      "type": "table"
    },

