    {
      "datasource": { "type": "postgres", "uid": "postgres_robot_ops" },
      "description": "Battery degradation score per robot in 30-minute buckets. Higher = more degraded. A steep rising curve indicates a failing battery.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Degradation Score",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line", "value": 80 }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT (DATE_TRUNC('minute', event_ts) - INTERVAL '1 minute' * MOD(EXTRACT(MINUTE FROM event_ts)::int, 30)) AS time, AVG(CASE WHEN robot_id = 'robot-001' THEN battery_degradation_score END) AS \"robot-001\", AVG(CASE WHEN robot_id = 'robot-002' THEN battery_degradation_score END) AS \"robot-002\" FROM telemetry_operational WHERE $__timeFilter(event_ts) AND battery_degradation_score IS NOT NULL GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Battery Degradation Trend (30-min buckets)",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "postgres", "uid": "postgres_robot_ops" },
      "description": "Validates all four sensor topics (/imu, /odom, /battery_state, /scan) are flowing for each robot.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Events/sec" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 0.1 },
                    { "color": "green", "value": 0.5 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 12,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT robot_id AS \"Robot\", source_topic AS \"Topic\", COUNT(*) AS \"Event Count\", MIN(event_ts) AS \"First Seen\", MAX(event_ts) AS \"Last Seen\", ROUND(COUNT(*) / GREATEST(EXTRACT(EPOCH FROM (MAX(event_ts) - MIN(event_ts))), 1)::numeric, 2) AS \"Events/sec\" FROM telemetry_operational WHERE $__timeFilter(event_ts) GROUP BY robot_id, source_topic ORDER BY robot_id, source_topic",
          "refId": "A"
        }
      ],
      "title": "Topic Throughput Breakdown",
      "type": "table"
    },

    {
