        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT (DATE_TRUNC('minute', event_ts) - INTERVAL '1 minute' * MOD(EXTRACT(MINUTE FROM event_ts)::int, 5)) AS time, SUM(CASE WHEN robot_id = 'robot-001' THEN anomaly_flag ELSE 0 END) AS \"robot-001\", SUM(CASE WHEN robot_id = 'robot-002' THEN anomaly_flag ELSE 0 END) AS \"robot-002\" FROM telemetry_operational WHERE $__timeFilter(event_ts) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Anomaly Hotspot Windows (5-min buckets)",
      "type": "timeseries"
    },

